#!/usr/bin/env ruby
# frozen_string_literal: true

# This script is a bootstrap script that ensures that the application is
# started with the correct environment variables set.

RODED_RUBYOPT = "--enable=frozen_string_literal --yjit"

unless ENV["RODED_BOOTSTRAPPED"]
  ENV["RODED_BOOTSTRAPPED"] = "1"
  ENV["RUBYOPT"] = [RODED_RUBYOPT, ENV.fetch("RUBYOPT", nil)].compact.join(" ")
  exec($PROGRAM_NAME, *ARGV)
end

require "roded"

frontend_name = "curses"
if ARGV.first == "--frontend"
  ARGV.shift
  frontend_name = ARGV.shift || ""
elsif ARGV.first&.start_with?("--frontend=")
  frontend_name = ARGV.shift.split("=", 2).last
end

app = Roded::Application.new
case frontend_name
when "curses"
  require "roded/frontends/curses"
  app.add_frontend(Roded::Frontends::Curses.new)
  app.welcome
  app.run
when "qt"
  require "roded/frontends/qt"
  frontend = Roded::Frontends::Qt.new(app)
  app.add_frontend(frontend)
  app.welcome
  frontend.run
else
  warn "Unknown frontend '#{frontend_name}'. Choose 'curses' or 'qt'."
  exit 2
end
